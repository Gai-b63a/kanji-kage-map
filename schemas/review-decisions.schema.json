{
  "type": "object",
  "properties": {
    "format": {
      "const": "glyph-review-decision-v1"
    },
    "review_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^(unicode:U\\+[0-9A-F]{4,6}|babelstone:han-pua:[^:]+:U\\+[0-9A-F]{4,6}|babelstone:ids-component:[^:]+:\\{[0-9]+\\})$"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "glyph_reference": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+@[1-9][0-9]*$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "whole_glyph",
            "feature"
          ]
        },
        "criterion": {
          "type": "string",
          "pattern": "\\S"
        },
        "source_id": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "kind",
        "criterion",
        "source_id"
      ],
      "additionalProperties": false
    },
    "decision": {
      "enum": [
        "equivalent",
        "different",
        "feature_agreement",
        "feature_difference",
        "inconclusive",
        "withdrawn"
      ]
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "human",
            "ai"
          ]
        }
      },
      "required": [
        "name",
        "kind"
      ],
      "additionalProperties": false
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "\\S"
        },
        "version": {
          "type": "string",
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "pattern": "\\S"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "locator": {
          "type": "string",
          "pattern": "\\S"
        },
        "edition_alignment": {
          "enum": [
            "verified",
            "unverified"
          ]
        }
      },
      "required": [
        "provider",
        "version",
        "url",
        "sha256",
        "locator",
        "edition_alignment"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "pattern": "\\S"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "locator": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "kind",
          "sha256",
          "locator"
        ],
        "additionalProperties": false
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "aspect": {
            "type": "string",
            "pattern": "\\S"
          },
          "result": {
            "enum": [
              "agreement",
              "difference",
              "not_checked"
            ]
          },
          "detail": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "required": [
          "aspect",
          "result",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "rationale": {
      "type": "string",
      "pattern": "\\S"
    },
    "supersedes": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "\\S"
        }
      ]
    }
  },
  "required": [
    "format",
    "review_id",
    "entity_id",
    "snapshot_sha256",
    "glyph_reference",
    "scope",
    "decision",
    "reviewer",
    "reviewed_at",
    "source",
    "evidence",
    "observations",
    "limitations",
    "rationale",
    "supersedes"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scoped glyph review decision v1",
  "$comment": "Enable date-time format assertion. Also run review_decisions.parse_history and candidate binding checks: scalar validity/canonical IDs, unique observation aspects, supersedes ordering, subject identity and database membership require semantic validation.",
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "kind": {
                "const": "whole_glyph"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "scope": {
            "properties": {
              "criterion": {
                "const": "structural_glyph_v1"
              }
            }
          },
          "decision": {
            "enum": [
              "equivalent",
              "different",
              "inconclusive",
              "withdrawn"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scope": {
            "properties": {
              "kind": {
                "const": "feature"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "enum": [
              "feature_agreement",
              "feature_difference",
              "inconclusive",
              "withdrawn"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "equivalent",
              "different"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "edition_alignment": {
                "const": "verified"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "equivalent"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "observations": {
            "items": {
              "properties": {
                "result": {
                  "const": "agreement"
                }
              }
            },
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "aspect": {
                      "const": "components"
                    }
                  }
                }
              },
              {
                "contains": {
                  "properties": {
                    "aspect": {
                      "const": "layout"
                    }
                  }
                }
              },
              {
                "contains": {
                  "properties": {
                    "aspect": {
                      "const": "stroke_topology"
                    }
                  }
                }
              },
              {
                "contains": {
                  "properties": {
                    "aspect": {
                      "const": "regional_form"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "different",
              "feature_difference"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "observations": {
            "contains": {
              "properties": {
                "result": {
                  "const": "difference"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "feature_agreement"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "observations": {
            "minItems": 1,
            "items": {
              "properties": {
                "result": {
                  "const": "agreement"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "withdrawn"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "supersedes": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    }
  ]
}
